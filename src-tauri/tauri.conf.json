{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZhixuWhale",
  "version": "0.3.0",
  "identifier": "dev.yank.zhixu-whale",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pet",
        "title": "鲸鱼娘",
        "url": "index.html",
        "width": 240,
        "height": 260,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Yank",
    "shortDescription": "知序的鲸鱼娘桌宠",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCQ0Y2Qjc1MzBBMkY5RTgKUldUbythSXdkV3ZQRy92Vkk5cmhQRER2ZzhieW1Xb0VFK2RZUGNMZzdtOGpmVGNsZHdyK2hid1oK",
      "endpoints": [
        "https://github.com/yankcc258/zhixu-whale-maid-pet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
